; lang.xon -- what this bundle IS.
;
; FORMAT (one form per line):
;   (lang "NAME")                the -l name
;   (dialect NAME)               he | xe | rn -- a REQUIREMENT, not a taste
;   (requires-lang "NAME")       another lang this one is written on top of
;   (requires-release "TAG")     the x-lang this bundle was built against
;   (entry "FILE")               loaded AFTER the dialect, not instead of it

(lang "sed")

; RADON for File, like the other tools of the arc.
; HELIUM, plus exactly the libraries this bundle imports and nothing
; ambient.  Radon is only a particular set of libraries to load, and
; the set it loads (the numeric tower, JIT-compiled tokenizer
; analysers) costs ~9s of every invocation that a tool never uses
; (measured 2026-09-02; the x-coreutils manifest has the numbers).
(dialect he)

; sed's regex layer is grep's: the BRE escape-swap translator and the byte
; doors ride in via grep/base, which x.sh arms as a library (import paths only;
; a required lang's entry never runs, so grep's operand dispatch cannot hijack
; sed's argv).
(requires-lang "grep")

(requires-release "v0.59.0")

(entry "run.x")

; The sed grammar, for any process that colours a file: sed/syntax imports
; x-lang libraries only.
(grammar sed (module sed/syntax) (files ".sed") (interpreters "sed" "gsed"))
